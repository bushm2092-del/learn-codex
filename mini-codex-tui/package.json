{
  "name": "mini-codex-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.tsx",
    "demo": "tsx src/index.tsx --demo",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts test/*.test.tsx"
  },
  "dependencies": {
    "ink": "7.1.1",
    "ink-text-input": "6.0.0",
    "marked": "^15.0.0",
    "react": "^19.2.0",
    "string-width": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
