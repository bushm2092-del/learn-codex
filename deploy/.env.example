# init 会生成随机数据库密码。已有数据库时不可随意更换密码或项目名。
POSTGRES_PASSWORD=REPLACE_ME
COMPOSE_PROJECT_NAME=learn-codex-site
# 默认仅本机可访问；公网反向代理接入本端口。域名与 HTTPS 尚未配置时先本地验证。
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8088
FRONTEND_ORIGIN=http://localhost:8088
# 仅本地 HTTP 验证设 false；生产 HTTPS 设 true。
COOKIE_SECURE=false
# 不从开发环境自动复制密钥；上线时单独填入对应 OAuth App 凭据。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
